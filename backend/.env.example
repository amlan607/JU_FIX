# Copy this file to backend/.env and adjust the values for your machine.
# Never commit the real .env file (Coding Standard 3.6).

APP_NAME=JU_FIX Medical Centre Automation System
ENVIRONMENT=development

# SQLite for local work. For PostgreSQL use:
# postgresql+psycopg://ju_fix:password@localhost:5432/ju_fix
DATABASE_URL=sqlite:///./ju_fix.db

# Generate a real secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-this-with-a-generated-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15

DEFAULT_SLOT_DURATION_MINUTES=20
DEFAULT_DAILY_TOKEN_LIMIT=30

CORS_ORIGINS=http://localhost:5173
